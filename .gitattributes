# scripts/run_mobile_relay_loop.bat is a Windows batch launcher — it must keep
# CRLF line endings on checkout regardless of core.autocrlf, since Windows'
# cmd.exe batch parser is unreliable with bare LF line endings (goto/label
# behavior in particular). See scripts/mobile_relay_socks5.py's docstring for
# the launcher's role (docs/discovery-pipeline-hardening.md Part 3).
scripts/run_mobile_relay_loop.bat text eol=crlf
