[Unit]
Description=Weekly public-domain Rule 2/3 candidate report + pd_probe retention prune
Documentation=https://github.com/rutvijmavani/auto-email
After=network-online.target postgresql.service
Wants=network-online.target
# Wants= (not Requires=): see staleness-checker.service. get_conn() failing exits non-zero -> OnFailure=.
Wants=postgresql.service
OnFailure=recruiter-pipeline-alert@%p.service

[Service]
Type=oneshot
User=opc
Group=opc
WorkingDirectory=/home/opc/mail
EnvironmentFile=/home/opc/mail/.env
ExecStart=/home/opc/mail/venv/bin/python -m scripts.pd_candidates --notify
TimeoutStartSec=900
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=tmpfs
BindPaths=/home/opc/mail
ReadWritePaths=/home/opc/mail
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pd-candidates
