[Unit]
Description=Recruiter Pipeline startup failure alert for %i
# This is a template unit — %i is passed from the failing unit.
# Non-template units use:    OnFailure=recruiter-pipeline-alert@%p.service
#   → %i = "recruiter-scheduler"  (plain service name)
# Template worker units use: OnFailure=recruiter-pipeline-alert@%p-%i.service
#   → %i = "domain-enrichment-worker-1"  (prefix-instance, no @)
# startup_failure_alert.py detects the prefix-N format and translates it to
# "prefix@N.service" for journalctl — preserving instance-specific log retrieval.
# Do NOT use %n (full name with .service suffix) — it would produce a double suffix.
# Sends a single email saying which service hit its StartLimitBurst.
#
# Network ordering: the alert script sends email — it must wait for full
# TCP connectivity or the SMTP connection will fail silently during early-boot.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=opc
Group=opc
WorkingDirectory=/home/opc/mail
EnvironmentFile=/home/opc/mail/.env

# %i = the failed service name (e.g. "recruiter-scheduler")
ExecStart=/home/opc/mail/venv/bin/python scripts/startup_failure_alert.py %i

# Don't restart — this is a one-shot alert, not a long-running service.
Restart=no

# ── Sandboxing ───────────────────────────────────────────────────────────────
# startup_failure_alert.py only reads journal logs and sends email — no writes
# outside the project directory are needed.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/opc/mail
