[Unit]
Description=Job Pipeline Streamlit Frontend
Documentation=https://github.com/rutvijmavani/auto-email
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=300s

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/home/opc/mail
EnvironmentFile=/home/opc/mail/.env
ExecStart=/home/opc/mail/venv/bin/streamlit run frontend/Home.py \
    --server.port 8501 \
    --server.headless true \
    --server.address 0.0.0.0 \
    --server.enableCORS false
Restart=always
RestartSec=15s
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30s
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# ProtectHome=tmpfs hides the rest of /home/opc (e.g. ~/.ssh) entirely. Under
# tmpfs mode ReadWritePaths= alone cannot re-expose a path — only BindPaths=/
# BindReadOnlyPaths= can bind a directory back into the empty tmpfs, keeping
# WorkingDirectory and ExecStart paths visible.
# The UI never writes to the repo: DB/Redis writes go over network sockets, the
# UI process never calls init_logging (no logs/ files), and the inline-discovery
# path never reaches the Brave quota file (data/brave_quota.json). So the repo is
# bound read-only — least privilege, unlike the workers that need logs/ and data/.
ProtectHome=tmpfs
BindReadOnlyPaths=/home/opc/mail
StandardOutput=journal
StandardError=journal
SyslogIdentifier=streamlit-frontend

[Install]
WantedBy=multi-user.target
