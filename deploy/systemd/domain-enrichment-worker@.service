[Unit]
Description=H1B domain enrichment worker (public domain + career URL resolution) — instance %i
Documentation=https://github.com/rutvijmavani/auto-email
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=300s
OnFailure=recruiter-pipeline-alert@%N.service

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/home/opc/mail
EnvironmentFile=/home/opc/mail/.env
Environment=WORKER_INSTANCE=%i
ExecStart=/home/opc/mail/venv/bin/python -m workers.domain_enrichment_worker
Restart=on-failure
RestartSec=30s
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=60s
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=tmpfs
BindPaths=/home/opc/mail
ReadWritePaths=/home/opc/mail
StandardOutput=journal
StandardError=journal
SyslogIdentifier=domain-enrichment-worker@%i

[Install]
WantedBy=multi-user.target
